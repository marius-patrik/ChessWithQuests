# Generated documentation source directory. `properdocs.yml` points docs_dir here because
# properdocs refuses a docs_dir that is the parent of its own config file; every page is
# generated by .github/scripts/docs_hooks.py, so only the placeholder is tracked.
.docs/*
!.docs/.gitkeep

# Game logs. The log directory is configurable, defaults to logs/ at the repository root,
# and is created on demand the first time a game writes to it.
logs/
