{
  "$comment": "Everything about this repository that the shared pipeline needs and cannot detect. The pipeline lives in marius-patrik/DarkFactory and is pinned below; the workflows here are callers, not copies.",
  "identity": {
    "owner": "marius-patrik",
    "repo": "ChessWithQuests",
    "display_name": "ChessWithQuests",
    "project_title": "ChessWithQuests",
    "agent_slug": "chesswithquests-agent",
    "default_branch": "main",
    "description": "School project of a chess game with customizable pieces, board, and quests.",
    "topics": [
      "chess",
      "python",
      "mvc",
      "game",
      "education"
    ]
  },
  "upstream": {
    "$comment": "The shared pipeline. `ref` is the pin: bump it to adopt a pipeline update, and the diff shows exactly what changed.",
    "repo": "marius-patrik/DarkFactory",
    "ref": "9bc3ab6f5602fd38755d94d0bc11461634600528"
  },
  "versioning": {
    "mode": "pridever",
    "tag_prefix": "v",
    "initial": "0.1.0"
  },
  "environment": {
    "$comment": "A Python application. The API reference is generated from docstrings by mkdocstrings, which properdocs still loads: it aliases mkdocs.* imports and reads mkdocs.plugins entry points.",
    "testing": {
      "python": {
        "command": "pytest",
        "versions": [
          "3.10",
          "3.11",
          "3.12",
          "3.13"
        ]
      }
    },
    "documentation": {
      "python": {
        "command": "properdocs build --strict",
        "source": "docstrings"
      }
    }
  },
  "areas": {
    "$comment": "ChessWithQuests's own domains. Declaration order is match order.",
    "$default": "core",
    "rules": {
      "description": "Move generation, check and mate detection, chess rule conformance",
      "keywords": [
        "rule",
        "rules",
        "move",
        "check",
        "mate",
        "castling",
        "promotion",
        "stalemate",
        "legal"
      ]
    },
    "pieces": {
      "description": "Piece definitions, movement and attack vectors, custom pieces",
      "keywords": [
        "piece",
        "pieces",
        "bishop",
        "knight",
        "rook",
        "queen",
        "king",
        "pawn",
        "vector"
      ]
    },
    "quests": {
      "description": "Quest system, objectives, progression and rewards",
      "keywords": [
        "quest",
        "quests",
        "objective",
        "reward",
        "progression",
        "challenge"
      ]
    },
    "board": {
      "description": "Board representation, custom board configurations, coordinates",
      "keywords": [
        "board",
        "square",
        "grid",
        "coordinate",
        "layout",
        "configuration"
      ]
    },
    "view": {
      "description": "Desktop UI, rendering, input handling",
      "keywords": [
        "view",
        "ui",
        "gui",
        "render",
        "window",
        "input",
        "display",
        "sprite"
      ]
    },
    "docs": {
      "description": "Documentation site, API reference, architecture notes",
      "keywords": [
        "doc",
        "docs",
        "documentation",
        "mkdocs",
        "mkdocstrings",
        "readme"
      ]
    },
    "ci": {
      "description": "GitHub Actions workflows, containers, runner scripts, repository automation",
      "keywords": [
        "ci",
        "action",
        "workflow",
        "pipeline",
        "docker",
        "runner",
        "automation"
      ]
    },
    "core": {
      "description": "Controller, model wiring, application lifecycle, configuration",
      "keywords": [
        "controller",
        "model",
        "mvc",
        "lifecycle",
        "config",
        "state",
        "engine"
      ]
    }
  },
  "required_checks": [
    "pipeline / pipeline (3.10)",
    "pipeline / pipeline (3.11)",
    "pipeline / pipeline (3.12)",
    "pipeline / pipeline (3.13)",
    "pipeline / rust",
    "pipeline / web",
    "pipeline / docs",
    "verify-docs",
    "verify-bound-issue"
  ],
  "board": {
    "global_title": "Global",
    "link_boards": [
      "Global",
      "ChessWithQuests"
    ]
  },
  "pages": {
    "build_type": "legacy",
    "branch": "gh-pages",
    "path": "/"
  },
  "documentation": {
    "$comment": "Sites offered by the switcher's Project axis.",
    "projects": [
      {
        "name": "DarkFactory",
        "url": "https://marius-patrik.github.io/DarkFactory/"
      },
      {
        "name": "Omnis",
        "url": "https://marius-patrik.github.io/omnis/"
      },
      {
        "name": "ChessWithQuests",
        "url": "https://marius-patrik.github.io/ChessWithQuests/"
      }
    ]
  }
}
