# Containerized Antigravity CI Agent
# Provides full parity between local execution and GitHub Actions CI.

FROM python:3.12-slim-bookworm

LABEL maintainer="marius-patrik"
LABEL description="Containerized Google Antigravity Agent environment with Python 3.12, dev tools, and GitHub CLI."

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# 1. Install base utilities, D-Bus, Secret Service, and GitHub CLI
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    curl \
    jq \
    ca-certificates \
    gnupg \
    dbus-x11 \
    gnome-keyring \
    libsecret-tools \
    tmux \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Google Antigravity CLI
RUN curl -fsSL https://antigravity.google/cli/install.sh | bash -s -- --dir /usr/local/bin \
    && agy --version

# 3. Setup project workspace and install Python test / build dependencies
WORKDIR /workspace

COPY pyproject.toml requirements-dev.txt /workspace/
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements-dev.txt

# 3. Create Antigravity home and configuration directory
RUN mkdir -p /root/.gemini/antigravity-cli

# 4. Copy runner entrypoint
COPY .github/scripts/antigravity_runner.py /usr/local/bin/antigravity-runner
RUN chmod +x /usr/local/bin/antigravity-runner

ENTRYPOINT ["dbus-run-session", "--", "python3", "/usr/local/bin/antigravity-runner"]
